{
  "name": "linkedin-text-formatter",
  "version": "1.2.0",
  "private": true,
  "description": "Write LinkedIn posts with Unicode formatting, Markdown conversion and a live feed preview.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:capture": "node scripts/demo/capture.mjs",
    "demo:build": "node scripts/demo/build.mjs",
    "demo:youtube": "DEMO_SCALE=2 node scripts/demo/build.mjs",
    "demo": "npm run build && npm run demo:capture && npm run demo:build",
    "ext:dev": "wxt",
    "ext:build": "wxt build",
    "ext:zip": "wxt zip",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "marked": "^18.1.1",
    "motion": "^14.1.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vefimov/termdub": "^1.1.0",
    "@wxt-dev/module-react": "^1.2.2",
    "puppeteer-core": "^25.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wxt": "^0.21.4"
  },
  "type": "module"
}
