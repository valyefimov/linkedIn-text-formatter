{
  "name": "linkedin-text-formatter",
  "version": "1.1.0",
  "private": true,
  "description": "Write LinkedIn posts with Unicode formatting, Markdown conversion and a live feed preview.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:capture": "node scripts/demo/capture.mjs",
    "demo:build": "node scripts/demo/build.mjs",
    "demo": "npm run build && npm run demo:capture && npm run demo:build"
  },
  "dependencies": {
    "marked": "^18.1.1",
    "motion": "^14.1.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vefimov/termdub": "^1.1.0",
    "puppeteer-core": "^25.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "type": "module"
}
